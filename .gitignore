# Python / Flask project gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env/

# IDE / editor settings
.vscode/
.idea/
*.iml

# OS files
Thumbs.db
.DS_Store

# Logs
logs/
*.log
app_flask*


#app (exclude config templates)
app/
!app/config/
app/config/__pycache__/

# Uploads / generated data
uploads/
data/generated_cases/

# Cache / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

test/

data/
*.json

README/

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment & config secrets (keep if you want them tracked)
.env.local
.env.*.local


temps/
*.txt





