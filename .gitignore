# Python / Flask project gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env/

# IDE / editor settings
.vscode/
.idea/
*.iml

# OS files
Thumbs.db
.DS_Store

# Logs
logs/
*.log
app_flask*

# App (ignore except config templates)
app/
!app/config/
app/config/__pycache__/

# Data directory (keep test_docs/ tracked — used by RAG)
data/
!data/test_docs/


# Uploads / generated data
uploads/

# Cache / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Test / generated outputs
test/
outputs/
chroma_data/

# Database (runtime artifact)
db/task.db
db/*.db
*.db

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment & config secrets
.env.local
.env.*.local

# Temp files
temps/
*.txt
